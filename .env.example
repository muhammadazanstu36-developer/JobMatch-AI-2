# ---------- AI (pick ONE; Gemini is free, no card needed) ----------
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternatives (free tiers): https://console.groq.com/keys  |  https://openrouter.ai/keys
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# Paid:
# ANTHROPIC_API_KEY=
# Optional: force a provider (gemini | groq | openrouter | anthropic) or a model name
# AI_PROVIDER=gemini
# AI_MODEL=

# ---------- Accounts ----------
# A long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# ---------- Jobs from LinkedIn / Indeed / Glassdoor ----------
# Free plan (about 200 requests/month): https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# Pages fetched per search (1-5). Each page uses one request of your quota.
# JSEARCH_PAGES=2
